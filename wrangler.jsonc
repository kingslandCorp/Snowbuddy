{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "snowbuddy",
  "compatibility_date": "2026-08-14",
  "observability": {
    "enabled": true
  },
  "main": "worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "www.snowbuddy.co.uk", "custom_domain": true },
    { "pattern": "snowbuddy.co.uk", "custom_domain": true }
  ],
  "kv_namespaces": [
    { "binding": "WEBCAM_KV", "id": "97f58c714f604998a92a91ca914650b3" }
  ],
  "triggers": {
    "crons": ["0 11 * * *"]
  }
}
